{
  "expo": {
    "name": "Charted",
    "slug": "charted-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "charted",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hu.pibasolutions.chartedmobile",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Charted needs your location to show you on the map and track your hikes.",
        "NSLocationWhenInUseUsageDescription": "Charted needs your location to show you on the map and track your hikes.",
        "NSLocationAlwaysUsageDescription": "Charted needs your location to track your hikes in the background."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hu.pibasolutions.chartedmobile",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Charted needs your location to show you on the map and track your hikes.",
          "locationWhenInUsePermission": "Charted needs your location to show you on the map and track your hikes.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EBEFEA",
          "dark": {
            "backgroundColor": "#EBEFEA"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InriaSerif-Regular.ttf",
            "./assets/fonts/Montserrat-Regular.ttf",
            "./assets/fonts/Montserrat-Medium.ttf",
            "./assets/fonts/Montserrat-SemiBold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b57c7a7c-689c-4760-aa72-cfee758320f8"
      }
    },
    "owner": "piba-solutions"
  }
}
